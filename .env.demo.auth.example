# Demo quase-produção — NÃO usar em produção real.
# Copiar: Copy-Item .env.demo.auth.example .env.demo.auth
# Gerar tokens no PowerShell:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })

FREEFLOW_AUTH_ENABLED=true
FREEFLOW_VIEWER_TOKEN=substituir-viewer-token-hex-32bytes
FREEFLOW_OPERATOR_TOKEN=substituir-operator-token-hex-32bytes
FREEFLOW_ADMIN_TOKEN=substituir-admin-token-hex-32bytes

# Mesmo valor no central-api (CENTRAL_AUTH_TOKEN) e no edge-uploader (EU_CLOUD_TOKEN).
CENTRAL_AUTH_TOKEN=substituir-central-cloud-token-hex-32bytes

FREEFLOW_MINIO_ACCESS_KEY=minioadmin
FREEFLOW_MINIO_SECRET_KEY=minioadmin
