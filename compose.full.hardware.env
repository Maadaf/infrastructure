# Ativar drivers de equipamento real (Hikvision / Ouster).
# Uso (PowerShell), a partir de infrastructure/:
#
#   docker compose -f compose.full.yaml --env-file compose.full.hardware.env up -d --force-recreate camera-gateway lidar-gateway
#
# Voltar ao lab (simulator):
#
#   Remove-Item Env:CG_DRIVER -ErrorAction SilentlyContinue
#   Remove-Item Env:LG_DRIVER -ErrorAction SilentlyContinue
#   docker compose -f compose.full.yaml up -d --force-recreate camera-gateway lidar-gateway

CG_DRIVER=hikvision
LG_DRIVER=ouster
