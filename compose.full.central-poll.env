# Overlay: gateways fazem poll do central-api (host Windows → porta 8090).
# Uso:
#   docker compose -f compose.full.yaml --env-file compose.full.central-poll.env up -d --force-recreate camera-gateway lidar-gateway radar-gateway rfid-gateway wim-gateway
#
# Ajustar GANTRY_ID ao id real no central (seed: a2-km25-s).
# CENTRAL_AUTH_TOKEN vazio = auth desligada no central.

CG_GANTRY_ID=a2-km25-s
CG_CENTRAL_URL=http://host.docker.internal:8090
CG_CENTRAL_TOKEN=
CG_POLL_INTERVAL_SECONDS=30
CG_EQUIPMENT_ID=cam-f-01

LG_GANTRY_ID=a2-km25-s
LG_CENTRAL_URL=http://host.docker.internal:8090
LG_CENTRAL_TOKEN=
LG_POLL_INTERVAL_SECONDS=30
LG_EQUIPMENT_ID=lidar-01

RG_GANTRY_ID=a2-km25-s
RG_CENTRAL_URL=http://host.docker.internal:8090
RG_CENTRAL_TOKEN=
RG_POLL_INTERVAL_SECONDS=30
RG_EQUIPMENT_ID=radar-01

TG_GANTRY_ID=a2-km25-s
TG_CENTRAL_URL=http://host.docker.internal:8090
TG_CENTRAL_TOKEN=
TG_POLL_INTERVAL_SECONDS=30
TG_EQUIPMENT_ID=ant-01

WG_GANTRY_ID=a2-km25-s
WG_CENTRAL_URL=http://host.docker.internal:8090
WG_CENTRAL_TOKEN=
WG_POLL_INTERVAL_SECONDS=30
WG_EQUIPMENT_ID=wim-01
